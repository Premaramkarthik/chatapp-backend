{
  "uid": "chatapp-auth",
  "title": "Chatapp Authentication",
  "tags": ["chatapp", "auth"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Signup Success",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "rate(signup_success_total[5m])", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Login Success / Failure",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "targets": [
        {"expr": "rate(login_success_total[5m])", "legendFormat": "success", "refId": "A"},
        {"expr": "sum(rate(login_failure_total[5m])) by (reason)", "legendFormat": "{{reason}}", "refId": "B"}
      ]
    },
    {
      "id": 3,
      "title": "Pending Verifications",
      "type": "stat",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "pending_verifications", "refId": "A"}]
    }
  ]
}
