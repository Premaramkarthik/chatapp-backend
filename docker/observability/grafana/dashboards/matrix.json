{
  "uid": "chatapp-matrix",
  "title": "Matrix Messaging",
  "tags": ["chatapp", "matrix"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Matrix Sessions Issued",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(matrix_session_issued_total[5m]))",
          "legendFormat": "sessions/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Room Create / Archive",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(matrix_room_create_total[5m])) by (outcome)",
          "legendFormat": "create {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(matrix_room_archive_total[5m]))",
          "legendFormat": "archive",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provision Errors",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(matrix_provision_errors_total[5m])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Synapse Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(synapse_http_server_requests_total[5m]))",
          "legendFormat": "synapse req/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Sync Failures",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(matrix_sync_failures_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Media Upload Metadata",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(matrix_media_upload_total[5m]))",
          "legendFormat": "uploads/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(matrix_media_failed_total[5m]))",
          "legendFormat": "failures/s",
          "refId": "B"
        }
      ]
    }
  ]
}
