{
  "uid": "chatapp-infra",
  "title": "Chatapp Infrastructure",
  "tags": ["chatapp", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Container CPU",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"chatapp.*|postgres|keycloak|redis.*\"}[5m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Container Memory",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"chatapp.*|postgres|keycloak|redis.*\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ]
}
