{
  "uid": "chatapp-database",
  "title": "Chatapp Database",
  "tags": ["chatapp", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Query p95 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_seconds_bucket[5m])) by (le, operation))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pool Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "database_connections_active", "legendFormat": "active", "refId": "A"},
        {"expr": "database_connections_idle", "legendFormat": "idle", "refId": "B"}
      ]
    },
    {
      "id": 3,
      "title": "Slow Queries (Loki)",
      "type": "logs",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "{job=\"chatapp-backend\"} |= \"db_query_completed\" | json | duration_ms > 500",
          "refId": "A"
        }
      ],
      "datasource": {"type": "loki", "uid": "loki"}
    }
  ]
}
