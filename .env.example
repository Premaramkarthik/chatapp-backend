APP_NAME=chatapp API
APP_ENV=local
APP_VERSION=0.1.0
APP_DEBUG=true
APP_SKIP_STARTUP_INTEGRATIONS=false

LOG_LEVEL=INFO
LOG_FILE=logs/backend.log
LOG_JSON=false

MIDDLEWARE_CORS_ENABLED=true
MIDDLEWARE_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
MIDDLEWARE_CORS_ALLOW_CREDENTIALS=true
MIDDLEWARE_CORS_ALLOW_METHODS=*
MIDDLEWARE_CORS_ALLOW_HEADERS=*
MIDDLEWARE_REQUEST_ID_HEADER=X-Request-ID
MIDDLEWARE_AUTH_ENABLED=true
MIDDLEWARE_AUTH_PROTECTED_PREFIXES=/v1
MIDDLEWARE_AUTH_PUBLIC_PATHS=/health/live,/health/ready,/metrics,/docs,/redoc,/openapi.json,/v1/system/version,/v1/auth/signin/start,/v1/auth/signin/callback,/v1/auth/forgot-password,/v1/auth/signup,/v1/auth/signup/resend,/v1/auth/signup/social/start
MIDDLEWARE_AUTH_PUBLIC_PREFIXES=/internal
MIDDLEWARE_RATE_LIMIT_ENABLED=true
MIDDLEWARE_RATE_LIMIT_REQUESTS=120
MIDDLEWARE_RATE_LIMIT_WINDOW_SEC=60
MIDDLEWARE_RATE_LIMIT_EXCLUDED_PATHS=/health/live,/health/ready,/metrics
MIDDLEWARE_DB_SESSION_ENABLED=true
MIDDLEWARE_DB_SESSION_EXCLUDED_PATHS=/health/live,/health/ready,/metrics,/docs,/redoc,/openapi.json,/v1/system/version,/internal/tinode/auth
MIDDLEWARE_LOG_REQUEST_BODY=false
MIDDLEWARE_CSRF_ENABLED=true
MIDDLEWARE_SECURITY_HEADERS_ENABLED=true
MIDDLEWARE_CSRF_EXCLUDED_PATHS=/health/live,/health/ready,/metrics,/docs,/redoc,/openapi.json,/v1/system/version,/v1/auth/signin/start,/v1/auth/signin/callback,/v1/auth/forgot-password,/v1/auth/signup,/v1/auth/signup/resend,/v1/auth/signup/social/start,/internal/tinode/auth
MIDDLEWARE_CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; base-uri 'self'
MIDDLEWARE_DOCS_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'
MIDDLEWARE_DOCS_CSP_PATHS=/docs,/redoc

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
PGADMIN_HOST_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

DB_HOST=localhost
DB_PORT=5433
DB_USER=chatapp
DB_PASSWORD=chatapp
DB_NAME=chatapp
DB_TARGET=direct
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_AUTO=true
DB_POOL_AUTO_CONCURRENT_REQUESTS=16
DB_POOL_AUTO_CEILING=10

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SEC=1.0
REDIS_CONNECT_TIMEOUT_SEC=1.0

KEYCLOAK_ENABLED=true
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8080
KEYCLOAK_INTERNAL_BASE_URL=http://localhost:8080
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/chatapp
KEYCLOAK_REALM=chatapp
KEYCLOAK_AUDIENCE=chatapp-api
KEYCLOAK_ALGORITHMS=RS256
KEYCLOAK_JWKS_REFRESH_INTERVAL_SEC=240
KEYCLOAK_STALE_JWKS_TTL_SEC=900
KEYCLOAK_WEB_CLIENT_ID=chatapp-web
KEYCLOAK_WEB_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=chatapp-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

AUTH_CALLBACK_URL=http://localhost:8000/v1/auth/signin/callback
AUTH_DEFAULT_POST_SIGNIN_REDIRECT_URL=http://localhost:3000
AUTH_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000
AUTH_COOKIE_NAME=pp_session
AUTH_CSRF_COOKIE_NAME=pp_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_ENCRYPTION_KEY=dev-auth-token-encryption-key-change-me
AUTH_SIGNIN_STATE_TTL_SEC=600
AUTH_SESSION_IDLE_SEC=1800
AUTH_SESSION_MAX_SEC=43200
AUTH_REFRESH_LEEWAY_SEC=60
AUTH_SESSION_CACHE_TTL_SEC=300
AUTH_REVOKE_CACHE_TTL_SEC=43200
AUTH_RESET_EMAIL_LIFESPAN_SEC=900
AUTH_CAPTCHA_REQUIRED=false
AUTH_SIGNUP_IDEMPOTENCY_TTL_SEC=86400
AUTH_SIGNUP_IP_LIMIT=5
AUTH_SIGNUP_IP_WINDOW_SEC=60
AUTH_SIGNUP_DEVICE_LIMIT=5
AUTH_SIGNUP_DEVICE_WINDOW_SEC=60
AUTH_SIGNUP_DOMAIN_LIMIT=20
AUTH_SIGNUP_DOMAIN_WINDOW_SEC=3600
AUTH_SIGNUP_RESEND_EMAIL_LIMIT=3
AUTH_SIGNUP_RESEND_EMAIL_WINDOW_SEC=900
AUTH_SIGNUP_SOCIAL_IP_LIMIT=10
AUTH_SIGNUP_SOCIAL_IP_WINDOW_SEC=60
AUTH_SIGNUP_RESEND_COOLDOWN_SEC=300
AUTH_SIGNUP_MAX_VERIFICATION_SENDS=5
AUTH_BLOCKED_EMAIL_DOMAINS=tempmail.com,guerrillamail.com,10minutemail.com
AUTH_DEFAULT_SIGNUP_ROLES=profile:update,session:manage,message:send,message:create-room,trip:create,trip:update,trip:join

TINODE_ENABLED=true
TINODE_WEB_URL=http://localhost:6060
TINODE_GRPC_HOST=localhost:16060
TINODE_API_KEY=dev-tinode-api-key
TINODE_REST_AUTH_SHARED_SECRET=dev-tinode-rest-auth-secret
TINODE_AUTH_LIFETIME_SEC=86400
TINODE_AUTH_ALLOW_PLAINTEXT_DEV_SECRET=true
# Set false in production; Tinode must call /internal/tinode/auth with the shared secret.
# Docker stack uses docker/tinode/tinode.conf (REST auth -> api service).
TINODE_GRPC_REQUIRED=false
TINODE_AUTO_PROVISION_ON_ACCEPT=false
# Optional: configure Tinode FCM/APNs and OOB media in tinode.conf for push and attachments.

MEILI_ENABLED=true
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key
MEILI_TRAVELER_INDEX=travelers
