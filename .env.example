# Secrets and connection URLs — operational defaults are in config.yaml (see docs/configuration-guide.md)
# Copy to .env and override as needed. Environment variables always win over YAML.

APP_ENV=local
APP_DEBUG=true

# Optional overrides (defaults in config.yaml if unset):
# HTTP_TIMEOUT_SECONDS=30
# HTTP_RETRY_ATTEMPTS=3
# KEYCLOAK_JWKS_CACHE_TTL_SEC=300
# JWT_CLOCK_LEEWAY_SEC=30

OBSERVABILITY_CORRELATION_HEADER=X-Correlation-ID

MIDDLEWARE_CORS_ENABLED=true
# Include localhost and 127.0.0.1 variants for Vite (5173), Next (3000), Lovable (8080)
MIDDLEWARE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:8000
MIDDLEWARE_CORS_ALLOW_CREDENTIALS=true
MIDDLEWARE_CORS_ALLOW_METHODS=*
MIDDLEWARE_CORS_ALLOW_HEADERS=*
MIDDLEWARE_REQUEST_ID_HEADER=X-Request-ID
MIDDLEWARE_AUTH_ENABLED=true
MIDDLEWARE_AUTH_PROTECTED_PREFIXES=/v1
MIDDLEWARE_AUTH_PUBLIC_PATHS=/health/live,/health/ready,/docs,/redoc,/openapi.json,/v1/system/version,/v1/auth/signin/start,/v1/auth/signin/callback,/v1/auth/signin/password,/v1/auth/forgot-password,/v1/auth/reset-password/complete,/v1/auth/signup,/v1/auth/signup/start,/v1/auth/signup/complete,/v1/auth/signup/resend,/v1/auth/signup/verify/complete,/v1/auth/signup/social/start
MIDDLEWARE_AUTH_PUBLIC_PREFIXES=/v1/geo
MIDDLEWARE_RATE_LIMIT_ENABLED=true
MIDDLEWARE_RATE_LIMIT_REQUESTS=120
MIDDLEWARE_RATE_LIMIT_WINDOW_SEC=60
MIDDLEWARE_RATE_LIMIT_EXCLUDED_PATHS=/health/live,/health/ready
MIDDLEWARE_DB_SESSION_ENABLED=true
MIDDLEWARE_DB_SESSION_EXCLUDED_PATHS=/health/live,/health/ready,/docs,/redoc,/openapi.json,/v1/system/version
MIDDLEWARE_LOG_REQUEST_BODY=false
MIDDLEWARE_CSRF_ENABLED=true
MIDDLEWARE_SECURITY_HEADERS_ENABLED=true
MIDDLEWARE_CSRF_EXCLUDED_PATHS=/health/live,/health/ready,/docs,/redoc,/openapi.json,/v1/system/version,/v1/auth/signin/start,/v1/auth/signin/callback,/v1/auth/signin/password,/v1/auth/forgot-password,/v1/auth/reset-password/complete,/v1/auth/signup,/v1/auth/signup/start,/v1/auth/signup/complete,/v1/auth/signup/resend,/v1/auth/signup/verify/complete,/v1/auth/signup/social/start
MIDDLEWARE_CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; base-uri 'self'
MIDDLEWARE_DOCS_CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'
MIDDLEWARE_DOCS_CSP_PATHS=/docs,/redoc

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=chatapp
DB_PASSWORD=chatapp
DB_NAME=chatapp

DB_TARGET=pgbouncer
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_HOST_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_CLIENT_CONN=100
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_AUTO=true
DB_POOL_AUTO_CONCURRENT_REQUESTS=16
DB_POOL_AUTO_CEILING=10

# Production Compose uses an externally managed PostgreSQL server. Set these in
# the production environment; its chatapp and keycloak databases/roles must exist.
# POSTGRES_HOST=db.example.internal
# POSTGRES_PORT=5432
# APP_DB_PASSWORD=<chatapp database password>
# KEYCLOAK_DB_PASSWORD=<keycloak database password>

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# Replace this local development placeholder with a strong random password.
REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_SOCKET_TIMEOUT_SEC=1.0
REDIS_CONNECT_TIMEOUT_SEC=1.0

KEYCLOAK_ENABLED=true
# Local dev: auto-create chatapp realm from deployment/keycloak/realm-chatapp.json.example
# Must be false in production (enforced when APP_ENV=production)
KEYCLOAK_AUTO_BOOTSTRAP=true
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_PUBLIC_BASE_URL=http://localhost:8180
KEYCLOAK_INTERNAL_BASE_URL=http://localhost:8180
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/chatapp
KEYCLOAK_REALM=chatapp
KEYCLOAK_AUDIENCE=chatapp-api
KEYCLOAK_ALGORITHMS=RS256
KEYCLOAK_JWKS_CACHE_TTL_SEC=300
KEYCLOAK_JWKS_REFRESH_INTERVAL_SEC=240
KEYCLOAK_STALE_JWKS_TTL_SEC=900
KEYCLOAK_WEB_CLIENT_ID=chatapp-web
KEYCLOAK_WEB_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_CLIENT_ID=chatapp-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# Google OAuth (Keycloak identity provider — applied on API startup when set)
# Google Cloud redirect URI: http://localhost:8180/realms/chatapp/broker/google/endpoint
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=
KEYCLOAK_GOOGLE_IDP_ALIAS=google
KEYCLOAK_GOOGLE_IDP_HIDE_ON_LOGIN_PAGE=true

# Optional: master admin for configure_keycloak_smtp.py (matches docker-compose bootstrap)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_BOOTSTRAP_ADMIN=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

# Keycloak realm SMTP (Gmail App Password recommended). Apply with:
# uv run python scripts/configure_keycloak_smtp.py [--test]
KEYCLOAK_SMTP_HOST=smtp.gmail.com
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=premaramkarthik@gmail.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=ChatApp
KEYCLOAK_SMTP_USER=premaramkarthik@gmail.com
KEYCLOAK_SMTP_PASSWORD=change-me
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false

AUTH_CALLBACK_URL=http://localhost:8000/v1/auth/signin/callback
# Match connect-carry VITE_BASE_PATH=/home on dev port 8080 (vite dev default)
AUTH_DEFAULT_POST_SIGNIN_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH_POST_LOGOUT_REDIRECT_URL=http://localhost:8080/
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080
AUTH_EMAIL_VERIFY_REDIRECT_URL=http://localhost:8080/verify-email/complete
AUTH_PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password
AUTH_COOKIE_NAME=pp_session
AUTH_CSRF_COOKIE_NAME=pp_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_DOMAIN=
# Set true in production (HTTPS). false for local http dev.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_TOKEN_ENCRYPTION_KEY=dev-auth-token-encryption-key-change-me
AUTH_SIGNIN_STATE_TTL_SEC=600
AUTH_SESSION_IDLE_SEC=1800
AUTH_SESSION_MAX_SEC=43200
AUTH_REMEMBER_ME_SESSION_MAX_SEC=2592000
AUTH_REFRESH_LEEWAY_SEC=60
AUTH_SESSION_CACHE_TTL_SEC=300
AUTH_REVOKE_CACHE_TTL_SEC=43200
AUTH_RESET_EMAIL_LIFESPAN_SEC=900
AUTH_EMAIL_VERIFICATION_TOKEN_TTL_SEC=900
AUTH_CAPTCHA_REQUIRED=false
AUTH_SIGNUP_IDEMPOTENCY_TTL_SEC=86400
AUTH_SIGNUP_IP_LIMIT=5
AUTH_SIGNUP_IP_WINDOW_SEC=60
AUTH_SIGNUP_DEVICE_LIMIT=5
AUTH_SIGNUP_DEVICE_WINDOW_SEC=60
AUTH_SIGNUP_DOMAIN_LIMIT=20
AUTH_SIGNUP_DOMAIN_WINDOW_SEC=3600
AUTH_SIGNUP_RESEND_EMAIL_LIMIT=3
AUTH_SIGNUP_RESEND_EMAIL_WINDOW_SEC=900
AUTH_SIGNUP_SOCIAL_IP_LIMIT=10
AUTH_SIGNUP_SOCIAL_IP_WINDOW_SEC=60
AUTH_SIGNUP_RESEND_COOLDOWN_SEC=60
AUTH_SIGNUP_MAX_VERIFICATION_SENDS=5
AUTH_SIGNUP_SESSION_TTL_SEC=1800
AUTH_VERIFICATION_RECONCILE_ENABLED=true
AUTH_VERIFICATION_RECONCILE_INTERVAL_SEC=300
AUTH_VERIFICATION_RECONCILE_BATCH_SIZE=50
AUTH_SIGNUP_MIN_PASSWORD_LENGTH=12
AUTH_SIGNUP_MAX_PASSWORD_LENGTH=128
AUTH_BLOCKED_EMAIL_DOMAINS=tempmail.com,guerrillamail.com,10minutemail.com
AUTH_DEFAULT_SIGNUP_ROLES=profile:update,session:manage,message:send,message:create-room,trip:create,trip:update,trip:join

MATRIX_ENABLED=true
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_PUBLIC_HOMESERVER_URL=http://localhost:8008
MATRIX_SERVER_NAME=matrix.local
MATRIX_SERVICE_ADMIN_USER=connectcarry-admin
MATRIX_SERVICE_ADMIN_PASSWORD=dev-synapse-service-admin-change-me
# MATRIX_ADMIN_TOKEN=syt_...  # emergency/debug override only — normal path uses service admin login
MATRIX_ACCESS_TOKEN_TTL_SEC=3600
MATRIX_SESSION_CACHE_TTL_SEC=300
MATRIX_REGISTRATION_SHARED_SECRET=dev-synapse-registration-secret-change-me
SYNAPSE_HOST_PORT=8008
# Use 9001 if host port 9000 is taken (e.g. Portainer)
MATRIX_IMAGE_MAX_BYTES=10485760
MATRIX_DOCUMENT_MAX_BYTES=26214400
MATRIX_VIDEO_MAX_BYTES=104857600
MATRIX_MESSAGE_RATE_LIMIT=60
MATRIX_MESSAGE_RATE_WINDOW_SEC=60
MATRIX_MEDIA_RATE_LIMIT=20
MATRIX_MEDIA_RATE_WINDOW_SEC=60

TYPESENSE_ENABLED=true
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-api-key
TYPESENSE_USERS_COLLECTION=users
TYPESENSE_TRAVELERS_COLLECTION=travelers
TYPESENSE_CITIES_COLLECTION=cities
TYPESENSE_COUNTRIES_COLLECTION=countries
TYPESENSE_STATES_COLLECTION=states
TYPESENSE_USER_RECOMMENDATIONS_COLLECTION=user_recommendations
TYPESENSE_POPULAR_SEARCHES_COLLECTION=popular_searches
SEARCH_CACHE_TTL_CITY_SEC=86400
SEARCH_CACHE_TTL_COUNTRY_SEC=86400
SEARCH_CACHE_TTL_STATE_SEC=86400
SEARCH_CACHE_TTL_USER_SEC=300
SEARCH_CACHE_TTL_TRAVELER_SEC=120
SEARCH_CACHE_TTL_GLOBAL_SEC=300
SEARCH_CACHE_TTL_RECENT_SEC=604800

# Hosted OIDC security bridge (generate a random secret; shared by API and Keycloak).
KEYCLOAK_DB_PASSWORD=dev-keycloak-db
# Password forms and app-owned recovery APIs are retired.
AUTH_VERIFICATION_RECONCILE_ENABLED=false

MATRIX_OIDC_CLIENT_ID=veliqone-matrix
MATRIX_OIDC_CLIENT_SECRET=dev-matrix-oidc-change-me
MATRIX_CALLBACK_URL=http://localhost:8000/v1/chat/matrix/callback
MATRIX_POST_LOGIN_URL=http://localhost:3000/chat
