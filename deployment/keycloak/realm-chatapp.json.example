{
  "realm": "chatapp",
  "enabled": true,
  "emailTheme": "veliqone",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 5184000,
  "actionTokenGeneratedByUserLifespan": 900,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and notEmail(undefined) and passwordHistory(5)",
  "smtpServer": {},
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Global administrator access."
      },
      {
        "name": "moderator",
        "description": "Global moderation access."
      },
      {
        "name": "support",
        "description": "Global support access."
      },
      {
        "name": "system",
        "description": "System/service access."
      }
    ],
    "client": {
      "chatapp-api": [
        {
          "name": "trip:create"
        },
        {
          "name": "trip:update"
        },
        {
          "name": "trip:join"
        },
        {
          "name": "message:send"
        },
        {
          "name": "message:create-room"
        },
        {
          "name": "profile:update"
        },
        {
          "name": "session:manage"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "chatapp-web",
      "name": "chatapp-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/v1/auth/signin/callback"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/ http://localhost:3000/"
      },
      "protocolMappers": [
        {
          "name": "chatapp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "chatapp-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "secret": "${KEYCLOAK_WEB_CLIENT_SECRET}"
    },
    {
      "clientId": "chatapp-api",
      "name": "chatapp-api",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": []
    },
    {
      "clientId": "chatapp-backend-admin",
      "name": "chatapp-backend-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": []
    },
    {
      "clientId": "veliqone-matrix",
      "name": "Veliqone Matrix",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-matrix-oidc-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8008/_synapse/client/oidc/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "profile"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      }
    }
  ],
  "users": [
    {
      "username": "service-account-chatapp-backend-admin",
      "enabled": true,
      "serviceAccountClientId": "chatapp-backend-admin",
      "clientRoles": {
        "realm-management": [
          "query-users",
          "view-users",
          "manage-users",
          "query-clients",
          "view-clients",
          "view-realm",
          "manage-realm"
        ]
      }
    }
  ],
  "identityProviders": [],
  "loginTheme": "veliqone",
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "defaultRole": {
    "name": "default-roles-chatapp",
    "composite": true,
    "composites": {
      "client": {
        "chatapp-api": [
          "profile:update",
          "session:manage",
          "message:send",
          "message:create-room",
          "trip:create",
          "trip:update",
          "trip:join"
        ]
      }
    }
  },
  "browserFlow": "veliqone-browser",
  "authenticationFlows": [
    {
      "alias": "veliqone-browser",
      "description": "Version-bound browser authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false
        },
        {
          "flowAlias": "veliqone-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "authenticatorFlow": true
        }
      ]
    },
    {
      "alias": "veliqone-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "OPTIONAL",
          "priority": 20,
          "authenticatorFlow": false
        }
      ]
    }
  ]
}
