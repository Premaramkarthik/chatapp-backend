version: 1
formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(message)s'
filters:
  callback_redaction:
    (): matrix_log_redaction.CallbackRedactionFilter
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
    filters: [callback_redaction]
loggers:
  synapse:
    level: INFO
  synapse.storage.SQL:
    level: WARNING
root:
  level: INFO
  handlers: [console]
